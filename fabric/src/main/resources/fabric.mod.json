{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "Enderboy500",
        "Ciph3rJ"
    ],
    "license": "${license}",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
          "net.enderboy500.netherandend.NetherAndEndFabric"
        ],
        "client": [
            "net.enderboy500.netherandend.client.NetherAndEndFabricClient"
        ]
    },
    "mixins": [
        "netherandend.mixins.json",
        "netherandend.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    }
}
  